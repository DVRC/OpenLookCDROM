%
%       Creation of load_popup
%

/load_popup
    null framebuffer /new ClassPopupWindow send
def

0 0 582 183 /reshape load_popup send
/Reshape? false /setattribute load_popup send
/Footer? false /setattribute load_popup send
(Jed:Load) /setlabel load_popup send

%
%       Creation of controls1
%

/controls1
    /Absolute framebuffer /new ClassPanel send
def

/colors load_popup send
/setcolors controls1 send

0 0 572 123 /reshape controls1 send

/Center controls1 /addclient load_popup send

%
%       Creation of load_directory
%
%

/load_directory-label
    (Directory:)  framebuffer /new ClassLabel send
def

/load_directory-label load_directory-label [8 100] /addclient controls1 send


/load_directory
    framebuffer /new ClassTextField send
def

    60 .75 mul cvi
/setminimumvisible load_directory send
/load_directory load_directory [ 83 100] /addclient controls1 send 

%
%       Creation of load_file
%
%

/load_file-label
    (File:)  framebuffer /new ClassLabel send
def

/load_file-label load_file-label [46 72] /addclient controls1 send

/load_file
    framebuffer /new ClassTextField send
def

    60 .75 mul cvi
/setminimumvisible load_file send
/load_file load_file [ 83 72] /addclient controls1 send 

load_file /setnextfocus load_directory send

%
%   Creation of load_button
%
%

/load_button
    /Absolute framebuffer /new ClassButtons send
def

[ (Load File) [ 0 0 ] ] /setitemlist load_button send
/load_button load_button [ 256 28] /addclient controls1 send 


