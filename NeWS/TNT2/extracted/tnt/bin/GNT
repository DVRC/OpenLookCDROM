#! /bin/sh
#
#	@(#)Newgnt	1.20	2/11/91


#	Revisions 
#		1.5		Adding {file}_t_gen.ps to allow customizing
#		1.20		New naming scheme
#		1.21		C++ output as .cc files, general cleanup
#				-t, -C, -m, -n, and -o options added
#				Fixed -S to not expect parameter.
#		------ Renumbered when moved to `new-world' ------
#		1.3		Added `generate:' target to generated Makefile
#				Remove ${file}.make in `clobber:' target.
#				Added header comments to generated Makefile.
#		1.4		Added GNT variable to generated Makefile.
#		1.5		Added C++ rules comment to generated Makefile
#		1.6		Added clean and clobber rules to generated
#				Instead of including ${file}.make, recur.
#				Necessary to make generate work after clobber.
#		1.7		Fixed up some chats
#		1.8		Exit immediatly if a subprog returns error.
#		1.9		Was quietly dieing if no flags specified.
#		1.10		Added 'P' option for portable
#		1.11		Fixed P and changed o to s
#		1.12		Changed order so interface is generated first
#		1.13		Took out g2ps -- no longer used
#		1.14		Took out uitocb -- also no longer used
#		1.15		Changed options to new choices
#		1.16		Fixed bug
#		1.17		Changed -n to -m
#		1.18		Fixed prompt

#   gnt Shell Script for controlling creation of TNTGuide Files
#
#   Options:
#	-c	Output traditional c.  Default for gnt and gntm.
#	-C	Output c++.  Default for GNT and GNTM.
#	-m	Do not execute make after creating files.
#	-v	Verbose.
#	-S	Produce PostScript which uses sharable subclasses.
#	-a	Allows portable code generation
#
#    Input:
#         {file}.G is the Guide Input File
#
#    Output:
#
#         Unconditional:
#
#	
#              {file}gen.ps     	PostScript Interface in Arrays
#					Deleted at end of run
#              {file}.ps.new      	"Runnable" Interface 
#              {file}_cps.cps.new    	cps functions for interface
#              {file}.make.new      	Makefile to create prototype
#              {file}.c.new    		c or C++ callback procedures
#
#         Conditional (Created if does not exist)
#
#		{file}.ps	Instead of {file}.ps.new
#		{file}_cps.cps	Instead of {file}_cps.cps.new
#		{file}.c	Instead of {file}.c.new
#		{file}.make	Instead of {file}.make.new
#		Makefile	has include of {file}.c.new
#
#         Prototype Make creates {file}
#
chat () {
    if  [ $VERBOSE -eq 1 ]; then
	echo "$@"
    fi
}

# Exit immediatly on error
set -e

CMDLINE="$@"

USAGE="Usage: $0 [-c | -C] [-m] [-v] [-a] [-S ] basefile"

VERBOSE=0
DOMAKE=1
OPTIND=1
OPTIONS=-
PORTABLE=0

# Set some defaults based on program name as executed.
case `basename $0` in
	gnt)	# Full, traditional c
		M=;
		CODE_EXT=.c;;
	GNT)	# Full, c++
		M=;
		CODE_EXT=.cc;;
esac

# Now parse the given options
while getopts mcvCSa c
do
    case $c in
	m)	# No make
		DOMAKE=0;;
	c)	# Traditional `c'
		CODE_EXT=.c;;
	v)	# Verbose
		VERBOSE=1;
		OPTIONS=${OPTIONS}v;;
	C)	# C++
		CODE_EXT=.cc;;
	S)	# Use subclassing
		OPTIONS=${OPTIONS}S;;
	a)	# ANSI (Portable) Code Generation
		PORTABLE=1;
		OPTIONS=${OPTIONS}a;;
	\?)	# Unrecognized parameter
		echo $USAGE;
		exit 2;;
    esac
done

# `shift 0' seems to quietly die...
if [ $OPTIND != 1 ] ; then shift `expr $OPTIND - 1` ; fi

if [ $# != 1 ]; then
    echo $USAGE
    exit 2
fi

#OPTIONS=${OPTIONS}${M:-s}
if [ "$CODE_EXT" = ".c" ]; then
	OPTIONS=${OPTIONS}c
else
	OPTIONS=${OPTIONS}C
fi

chat "Options: $OPTIONS"

#  If TNTGUIDEHOME is defined, use that directory, otherwise program directory
#

PROGDIR=${TNTGUIDEHOME:-`dirname $0`}/

file=`basename $* .G`

if [ -s ${file}.G ]; then
	chat "Processing $file"
else
	echo $file.G does not exist
	exit 
fi


#    Remove unconditionally the files unconditionally created

rm -f ${file}.ps.new ${file}gen.cps.new ${file}.make.new
rm -f ${file}${CODE_EXT}.new


#
# Finally, create the various output files
#
chat "Running genui"
${PROGDIR}genui	 $OPTIONS ${file};
chat "Running cside"
${PROGDIR}cside  $OPTIONS ${file}


#    if the conditional files do not exist copy the unconditional to
#    conditional

for f in .make ${CODE_EXT} _cps.cps .ps
do
	if  [ ! -f ${file}${f}	]; then
		chat "moving ${file}${f}.new to ${file}${f}"
		mv ${file}${f}.new ${file}${f}
	fi
done

# ----------------------------------------
#   And build a top-level makefile if necessary
#
if [ ! -f Makefile ]; then
	chat "Constructing Makefile"
	cat << EOF > Makefile
#!/usr/bin/make
#
#	Make file generated by $0
#
#	When using C++, this make file assumes that the standard rules for
#	compiling and linking C++ files are included in your default rule
#	set.  This will be the case if you are running SunOS 4.1 or later.
#	If not, see Appendix F of the Sun C++ Programmer's Guide.

GNT	= $0

default all clean clobber:
	$(MAKE) -f ${file}.make \$@

generate:
	$(GNT) $CMDLINE

EOF
fi
# ----------------------------------------


#
#    Make the prototype {file} using the conditional compilations
#
if  [ $DOMAKE -eq 1 ]; then
	echo
	echo	Making ${file} using Makefile
	echo

	make -f ${file}.make
fi
