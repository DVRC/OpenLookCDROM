% systemdict begin

/DefaultMenuButton /RightMouseButton def

/currentlinequality	{ 0 } def	% Compatibility ...
/setlinequality		{ pop } def	% with NeWS 1.1
/geteventname		{ /Name get } def
/geteventaction		{ /Action get } def
/geteventclientdata	{ /ClientData get } def
/geteventtimestamp	{ /TimeStamp get } def
/geteventcanvas		{ /Canvas get } def
/geteventlocation	{ dup /XLocation get exch /YLocation get } def
/seteventname		{ exch dup /Name 4 -1 roll put } def
/seteventaction		{ exch dup /Action 4 -1 roll put } def
/seteventclientdata	{ exch dup /ClientData 4 -1 roll put } def
/seteventtimestamp	{ exch dup /TimeStamp 4 -1 roll put } def
/seteventcanvas		{ exch dup /Canvas 4 -1 roll put } def
/seteventlocation	{ 2 index /YLocation 2 index put pop
			  1 index /XLocation 2 index put pop} def
/createcanvas { gsave initmatrix 0 0 moveto rect newcanvas
		dup reshapecanvas grestore } def
/setcanvasshape { gsave initmatrix pathbbox pop pop translate
		  reshapecanvas grestore } def

/currentmouse		/currentcursorlocation load	def

/bottomcanvas		{ /BottomCanvas get } def
/canvasabove		{ /CanvasAbove get } def
/canvasbelow		{ /CanvasBelow get } def
/colorcanvas		{ currentcanvas /Color get } def
/monochromecanvas	{ currentcanvas /Color get not } def
/mapped			{ /Mapped get } def
/mapcanvas		 { /Mapped true put } def
/unmapcanvas		 { /Mapped false put } def
/getcanvasopacity	{
    /EventsConsumed get {
	/AllEvents	{ /Opaque }
	/MatchedEvents	{ /Partial }
	/NoEvents	{ /Clear }
    } case
} def
/setcanvasopacity {		%  event kwd  =>
    {
	/Opaque		{ /AllEvents }
	/Partial	{ /MatchedEvents }
	/Clear		{ /NoEvents }
    } case
    /EventsConsumed exch put
} def
/parentcanvas		{ /Parent get } def
/makecanvasnonretained	{ /Retained false put } def
/makecanvasretained	{ /Retained true put } def
/retained		{ /Retained get } def
/savebehindcanvas	{ /SaveBehind true put } def
/topcanvas		{ /TopCanvas get } def
/topchildcanvas		{ /TopChild get } def
/makecanvasopaque	{ /Transparent false put } def
/makecanvastransparent	{ /Transparent true put } def
/transparent		{ /Transparent get } def
/fontascent		{ /FontAscent get } ?def
/fontdescent		{ /FontDescent get } ?def
/fontheight		{ /FontHeight get } ?def
/forkunix		{ runprogram } def
/^C			{ shutdownserver } def


% Class cataclysm:
/makewindow { %  hook width height => window
    framebuffer /new DefaultWindow send		% hook width height win
    0 0 6 3 roll 3 -1 roll			% win 0 0 width height hook
    /doit 6 index send				% win 0 0 width height
    /reshape 5 index send			% win
} def
/makewindowfromuser { %  hook => window
    framebuffer /new DefaultWindow send	exch	% win hook
    /doit 2 index send				% win
    /reshapefromuser 1 index send		% win
    /map 1 index send				% win
} def
/showwindow { %  win x y => -  (Moves window/icon to x y)
    /move 3 index send
    /map exch send
} def
% Fake windowpackage
/windowpackage 20 dict dup begin
    /getclientcanvas {begin ClientCanvas end} def % may be a proc!
    /getframecanvas {/FrameCanvas get} def
    /geticoncanvas {/IconCanvas get} def
    /iconic {/Iconic? get} def

    /getfbrect {gsave fboverlay setcanvas getrect grestore} def
    /getfbwholerect {gsave fboverlay setcanvas getwholerect grestore} def

    /movewindow {/move 4 -1 roll send} def
    /windowtotop {/totop exch send} def

    /thiswindow { self } def
    /paintwindow { /paint exch send } def
end def
/makemenu { %      keys actions => menu
	    % -or- keys/actions (one array) => menu
    /new DefaultMenu send
} def
/showmenu { %  menu => -  (Forks menu at mouse)
    /popup exch send
} def
% Fake menupackage
/menupackage 20 dict dup begin
    /addmenuitem { % menu index key proc => -
	/insertitem 5 -1 roll send
    } def
    
    /deletemenuitem { % menu index => -
	/deleteitem 3 -1 roll send
    } def
end def

/ColorDisplay? { framebuffer /Color get } def    

