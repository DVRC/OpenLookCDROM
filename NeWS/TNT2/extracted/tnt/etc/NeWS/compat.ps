% lite{win,menu,item} & util needed changes for this; some
% demos need them still.
/LeftMouseButton	dup def
/MiddleMouseButton	dup def
/RightMouseButton	dup def
/MouseDragged		dup def
/DownTransition		dup def
/UpTransition		dup def

% An errordict that simply stops on all errors.
/StopOnErrorsDict StandardErrorNames dup length dict begin
    { {pop stop} def } forall
    currentdict
    end
def
% A procedure acting like "stopped" even in the presence of an errordict.
/errored { % proc => bool (executes proc, returning true if error occurred)
10 dict begin
    /realerrordict currentprocess /errordict get def
    currentprocess /errordict StopOnErrorsDict put
    stopped
    currentprocess /errordict realerrordict put
end
} def

/popmsg { 	% cx cy strings => process
  { 20 dict begin newprocessgroup
    dup type /arraytype ne { 1 array astore } if
    /strs exch def
    /y exch def
    /x exch def
    /Times-Roman findfont 24 scalefont setfont
    0 setgray
    /width 0 def
    strs { stringwidth pop width max /width exch def } forall
    /height strs length 30 mul def
    /x0 x 10 sub def
    /y0 y 25 add def
    /x1 x0 width add 20 add def
    /y1 y0 height 5 add sub def
    x0 y0 10 sub moveto
    x0 y1 x1 y1 10 arcto
    x1 y1 x1 y0 10 arcto
    x1 y0 x0 y0 10 arcto
    x0 y0 x0 y1 10 arcto clear
    /cv framebuffer newcanvas def
    closepath
    cv reshapecanvas cv setcanvas
    cv /SaveBehind true put
    cv /Mapped true put

    [
	/Damaged {
	    pop
	    damagepath clipcanvas
	    clippath 0 setgray fill
	    /ix0 x0 2 add def 
	    /iy0 y0 2 sub def
	    /ix1 x1 2 sub def 
	    /iy1 y1 2 add def
	    ix0 iy0 10 sub moveto
	    ix0 iy1 ix1 iy1 10 arcto
	    ix1 iy1 ix1 iy0 10 arcto
	    ix1 iy0 ix0 iy0 10 arcto
	    ix0 iy0 ix0 iy1 10 arcto clear
	    1 setgray fill
	    ColorDisplay? { 
		1 .5 .5 sethsbcolor 
	    } { 
		0 setgray 
	    } ifelse
	    /t y def
	    strs { 
		x t moveto show /t t 30 sub def 
	    } forall
	} null cv eventmgrinterest

	/LeftMouseButton {
	    pop quit
	} /UpTransition cv eventmgrinterest
    ] forkeventmgr waitprocess pop
  } fork pause
  4 1 roll pop pop pop
} def



%%%%%%%%%%%%%%%%
% from util.ps %
%%%%%%%%%%%%%%%%


/modifyproc {		% /proc {head} {tail}  =>  {head proc tail}
			% Note: any of proc, head, tail may be keywords.
    10 dict begin
        /defbody {dup type /nametype eq {load} if def} def
        /tail exch defbody
        /head exch defbody
        /proc exch defbody
        [ /head load aload pop /proc load aload pop /tail load aload pop ] cvx
    end
} def


% ----------------------------------------------------------
% Here is a simple client-side synchronizer utility: (cid=ClientID)
% ----------------------------------------------------------
%
systemdict /currentcid 0 put

/uniquecid {
    currentcid 1 add /currentcid 1 index store
} def

/cidinterest { 		% id => interest
    /CIDEvent {/ClientData get cvx exec} 3 -1 roll null eventmgrinterest
} def

/cidinterest1only { 	% id => interest
    /CIDEvent 		% id name
    {/ClientData get cvx exec exit} % id name proc
    3 -1 roll null 	 % name proc id null
    eventmgrinterest
} def

/sendcidevent { 	% id proc => - (Send client-supplied proc to id eventmgr)
    createevent begin
	/Name		/CIDEvent def
	/ClientData	exch def
	/Action		exch def
	currentdict
    end sendevent
} def

%
% Old style cursor support
%

/setcanvascursor { % font shape mask => -
    3 -1 roll				% shape mask font
    newcursor				% cursor
    currentcanvas			% cursor canvas
    exch /Cursor exch put		% -
} ?def

/getcanvascursor { % - => font shape mask

    % Search for a cursor.  If we don't have one, try our parent.
    % REMIND: This code will blow up if the local root canvas does not
    % have a cursor.

    currentcanvas
    {
	dup				% canvas canvas
	/Cursor get dup			% canvas cursor cursor
	null eq {
	    pop /Parent get
	} {
	    exit
	} ifelse
    } loop
					% canvas cursor
    exch pop				% cursor
    begin
	CursorFont CursorChar MaskChar
    end
} ?def


