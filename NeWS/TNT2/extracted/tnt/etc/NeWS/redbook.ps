/edieresis /egrave /eth /iacute /icircumflex /idieresis /igrave /logicalnot 
/minus /mu /multiply /ntilde /oacute /ocircumflex /odieresis /ograve /onehalf 
/onequarter /onesuperior /otilde /plusminus /registered /scaron /thorn 
/threequarters /threesuperior /trademark /twosuperior /uacute /ucircumflex 
/udieresis /ugrave /yacute /ydieresis /zcaron ] def
end

%
% set graphics defaults.
%

{ /Courier findfont 12 scalefont setfont } stopped {
    (XNeWS: can't find fonts!\nFONTPATH=") (FONTPATH) () ?getenv (".\n)
    append append FatalError
} if
initgraphics
