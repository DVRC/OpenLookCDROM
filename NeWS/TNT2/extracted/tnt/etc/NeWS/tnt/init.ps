% Wire Service:
    /wire_Sync				(NeWS/tnt/wire.ps)
    /ClassWireClient			(NeWS/tnt/wire.ps)

% JOT
    /ClassJotText			(NeWS/tnt/jot.ps)
    /ClassJotCanvas			(NeWS/tnt/jot.ps)

% PostScript Capture:
    /PSCapture                          (NeWS/tnt/capture.ps)

% Help
    /ClassTNTHelpWindow	    	    	(NeWS/tnt/help.ps)
    /ClassNoHelpNotice			(NeWS/tnt/help.ps)
] DefineAutoLoads

% We can't load all of UI.ps here, because this file is read BEFORE class.ps,
% but we must at least define UserProfile default values since those are hard
% to set up as autoloads.

    UserProfile
    dup /StopKey	/FunctionL1		?put
    dup /AgainKey	/FunctionL2		?put
    dup /PropsKey	/FunctionL3		?put
    dup /UndoKey	/FunctionL4		?put
    dup /FrontKey	/FunctionL5		?put
    dup /CopyKey	/FunctionL6		?put
    dup /OpenKey	/FunctionL7		?put
    dup /PasteKey	/FunctionL8		?put
    dup /FindKey	/FunctionL9		?put
    dup /CutKey		/FunctionL10		?put

    dup /PointButton	/LeftMouseButton	?put
    dup /FocusButton	/LeftMouseButton	?put
    dup /AdjustButton	/MiddleMouseButton	?put
    dup /RestoreButton	/MiddleMouseButton	?put
    dup /MenuButton	/RightMouseButton	?put

    % Note: Use array rather than the pseudo-name /Control, because these
    % values may be used in places other than ClassKeyboard's /modifierdown?.
    dup /DuplicateModifier  	[/LeftControl /RightControl]   	?put
    dup /panModifier	    	[/LeftControl /RightControl]   	?put
    dup /ConstrainModifier  	[/LeftControl /RightControl]   	?put
    dup /SetMenuDefaultModifier	[/LeftControl /RightControl]   	?put

    dup /DragThresh		  5		?put	%  this is pixels
    dup /ScrollDelay		200 		?put	%  these 3 are ms.
    dup /ScrollThresh		400		?put
	/MultiClickThresh	390		?put


