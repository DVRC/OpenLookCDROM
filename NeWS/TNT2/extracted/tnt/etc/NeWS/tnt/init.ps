    /OpenService			(NeWS/tnt/UI.ps)
    /ClassFunctionKey			(NeWS/tnt/UI.ps)
    /ClassUI				(NeWS/tnt/UI.ps)
    /ISOLatinKeys			(NeWS/ISOkeys.ps)
    /ClassFullScreenInterest		(NeWS/fullscreen.ps)
    /MenuService			(NeWS/tnt/menu.ps)
    /ClassSelectUI			(NeWS/tnt/selectUI.ps)
    /ClassTextCanvas			(NeWS/tnt/canvas.ps)

    /ClassCanvas			(NeWS/tnt/canvas.ps)
    /ClassControl			(NeWS/tnt/control.ps)
    /ClassItemGroup			(NeWS/tnt/group.ps)
    /ClassDrawable			(NeWS/tnt/drawable.ps)
    /ClassFramebuffer			(NeWS/tnt/canvas.ps)
    /ClassMenu				(NeWS/tnt/menu.ps)
    /ClassScrollList			(NeWS/tnt/list.ps)
    /ClassBag				(NeWS/tnt/bag.ps)
    /ClassBorderBag			(NeWS/tnt/borderbag.ps)
    /ClassWindow			(NeWS/tnt/window.ps)
    /ClassBaseWindow			(NeWS/tnt/window.ps)
    /ClassPopupWindow			(NeWS/tnt/window.ps)
    /ClassVScrollbar			(NeWS/tnt/scrollbar.ps)
    /ClassHScrollbar			(NeWS/tnt/scrollbar.ps)
    /ClassHSlider			(NeWS/tnt/slider.ps)
    /ClassVSlider			(NeWS/tnt/slider.ps)
    /ClassHGauge			(NeWS/tnt/gauge.ps)
    /ClassVGauge			(NeWS/tnt/gauge.ps)
    /ClassLabel				(NeWS/tnt/label.ps)
    /ClassRegion			(NeWS/tnt/region.ps)
    /ClassButtons			(NeWS/tnt/buttons.ps)
    /ClassMenuButtons			(NeWS/tnt/buttons.ps)
    /ClassNumericField			(NeWS/tnt/numfield.ps)
    /ClassLayout			(NeWS/tnt/layout.ps)
