%
% Make the standard auto loads:
%
[
%
% New world classes - this whole file needs a complete work-over
%
    /ClassTrackInterest			(NeWS/track.ps)
    /TrackService			(NeWS/track.ps)
    /ObsoleteService			(NeWS/obsolete.ps)
    /KeyService				(NeWS/keysint.ps)
    /DamageService			(NeWS/tnt/UI.ps)
    /FrontService			(NeWS/tnt/UI.ps)
