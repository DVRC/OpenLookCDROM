%
%   keyinterest.ps: basic interest classes for the keyboard

%    ClassShiftInterest
%
%    A Shift interest is a Dependent interest that maintains some record
%    of an existing state, modified by the events it matches.  The most
%    common example is an interest that watches the shift keys (and related
%    keys such as control, meta, and capslock); hence the class name.
%
%    Shift interests are closely linked with Keys interests (defined later).
%    Keys interests modify themselves based on external update requests.  Most
%    often, these updates are generated by Shift interests.  Whenever the
%    Shift's state record changes, the new state is sent to each Keys interest
%    associated with this Shift.
%
/ClassShiftInterest ClassDependentInterest dictbegin
    /Keys	 nulldict	def
    /LockState		0	def
    /ShiftState		0	def
dictend classbegin

% Defaults:

% Class variables:

    % Shift keys have higher priority than ordinary keys so that the shift
    % affects subsequent keys even if there is also an explicit interest in
    % the shift key itself.  ShiftInts are synchronous for the same reason.
    %
    /Priority		ShiftKeyPriority  def
    /Synchronous	true	  	  def

    %	ShiftActionDict handles transitions on a shift (modifier) key.
    %
    /ShiftActionDict dictbegin
	 /DownTransition	/ShiftChange buildinterestsend		def
	 /UpTransition		//DownTransition			def
    dictend def

    % These are the "standard" shift key bit flags, used for building some
    % basic shiftdicts.
    %
    /Shift	1	def
    /Caps	2	def
    /Control	4	def
    /Meta	8	def
    /NumLock	16	def
    /Alt	32	def
    /Altgraph	64	def
    /AltGraph	64	def	% maintained for compatibility

% Methods:

    %   Override: Shift interests are global (null canvas) and have a fixed
    %   /Action dict.  The client specifies only the mapping of keystations
    %   to state bits and an initial NotifyInterest (null if none).  Because
    %   the superclass consumes a different number of args if a NotifyInterest
    %   is given, this override is a bit tricky.
    %
    /NewInit { % shiftdict notifyinterest|null  => -
        null ShiftActionDict 3 index 		%  Sdict Nint null SAD Sdict
        /NewInit super send	 		%  - (Nint case) -or-
						%  Sdict (null case)
	NotifyInterest null eq {pop} if
	/Keys growabledict def
    } def

    %   Override: Disown all our Keys interests.
    %
    /destroy { % - => -
    	/Keys nulldict def
	/destroy super send
    } def

    %   Override: Compute initial state and update our Keys interests with it.
    %
    /activate { % event  =>  -
	dup /activate super send		%  ev
	dup /KeyState get true exch		%  ev true [downkeys]
	/ComputeShiftState self send		%  state
	/UpdateKeys self send
    } def

    %   Update Keys with a new shift state.
    %
    /UpdateKeys { % state => -
    	dup Keys {				% state state Kint any
    	    pop /update exch send		% state
    	    dup
    	} forall				% state state
    	pop /ShiftState exch def
    } def

    %   Add a new KeysInterest to an existing ShiftInterest.  The Keys is
    %   immediately updated if the Shift is currently active.  This method
    %   is called by the Keys in its /NewInit method.  Clients should not
    %	call this method directly.
    %
    /AddKeys { % Kint  =>  -
    	/Active? self send {
    	    ShiftState /update 2 index send
    	} if						% Kint
    	Keys exch null put
    } def

    %   Remove a KeysInterest.  This method is called by the Keys in its
    %   /destroy method.  Clients should not call this method directly.
    %
    /RemoveKeys { % Kint => -
    	Keys exch undef
    } def

    %   Return the current ShiftState of this interest.
    %
    /shiftstate { %  - => int
	ShiftState
    } def

% Utilities

    %	ShiftChange is invoked when a transition occurs on a shift-key;
    %	it runs in the event-manager process.  Rather than modify the
    %   ShiftState incrementally, it recomputes it; this is about as
    %   fast as an incremental method, and makes it easy to handle the
    %   case where both shift keys are down and one then goes up.
    %
    /ShiftChange { % event  =>  -
    	false 1 index /KeyState get		%  ev false [downkeys]
    	/ComputeShiftState self send		%  state
    	dup ShiftState ne {
    	    /UpdateKeys self send
    	} {
    	    pop
    	} ifelse
	unblockinputqueue
    } def

    %   ComputeShiftState is called with an event and a KeyState array;
    %	it figures the current state of the shift-keys from scratch.
    %   (The LockState is maintained across calls, however.)  The event
    %   is required because the KeyState of a DownTransition event does
    %   not include the key that just went down.
    %
    %   The boolean arg is 'true' if the event's Name should be looked up in
    %   the shift dict.  (If the event matched the Shift event, the event
    %   distribution mechanism has already replaced the Name with the value
    %   found in the shift dict.  If the event is the triggering event for
    %   our Notify, we need to do the lookup ourselves.)
    %
    /ComputeShiftState { %  ev bool [downkeys... ]  =>  state
    	% We start by putting a procedure on the stack; the proc will be the
    	% body of a forall over the keystate array, and will also be executed
    	% for the event's Name if bool is true and Action is DownTransition.
    	% The comments on the procedure describe the state of the stack when
    	% the procedure is executed.  The sdict is the Interest's (not ev's)
    	% Name field.
    	{					%  ... state sdict key
    	    2 copy known {
    	    	% Don't bother with stack magic to preserve sdict; just
    	    	% get a new copy when we're done.
    	    	get dup type /integertype eq { or } { pop } ifelse
    	    	Name				%  ... state sdict
    	    } {
    	    	pop				%  ... state sdict
    	    } ifelse
    	}
    	dup LockState Name		% ev bool [keys] proc proc state sdict
    	5 -2 roll forall			% ev bool proc state sdict
    	5 -1 roll dup
    	/Action get /DownTransition eq {	% bool proc state sdict ev
    	    /Name get 5 -2 roll			% state sdict key|bit bool proc
    	    % See initial comment; if bool is 'true' the key|bit is a key to
    	    % be looked up in sdict using proc, else it's already been looked
    	    % up and is a shiftstate bit (or null).  So now we give the proc
    	    % for the 'false' branch, in which case the /Name is guaranteed
    	    % to be a bit (if it was a keystation that mapped to a proc, the
    	    % proc replaced the Name in the event with zero).
    	    {					% state sdict bit
    	    	exch pop or null		% state null
    	    } ifelse
    	    pop
    	} {
    	    5 -2 roll pop pop pop pop		% state
    	} ifelse
    } def

    %   LockChange is the default ShiftChange handler for a locking shift-key;
    %	it complements a specific bit each time it sees a Down on its key.
    %   It also zeroes the Name in the event, so that ShiftChange won't try
    %   to treat the keystation int as a shiftstate bit.
    %
    /LockChange { %  event bit  =>  event'
    	1 index /Action get /DownTransition eq {
    	    LockState xor /LockState exch def
    	} {
    	    pop
    	} ifelse
    	dup /Name 0 put
    } def

classend def

%    ClassKeysInterest
%
%    A Keys interest is an interest that modifies itself based on the state
%    of a Shift interest.  The agreed upon protocol is that the Shift
%    interest sends the Keys interest an integer, and the Keys decides how to
%    update itself.  The "standard" class uses the int as an index into an
%    array of dicts for use in the Name field; the selected dict maps
%    keystations into characters according to the state of the shift keys.
%    Subclasses can override this behavior if other clients of this
%    Shift/Keys relationship are discovered.
%
%    ClassKeyService includes methods for creating Shift and Keys interests,
%    so most clients will deal only with the KeyService.
%
/ClassKeysInterest ClassDependentInterest [
    /ShiftInterest
    /Maps
]
classbegin

% Class variable overrides:

    /Exclusivity true def
    
% Methods:

    %	Override: In place of name/action/canvas, which are hardwired (or
    %	filled in later), the client instead supplies an array of keymaps
    %	and the ShiftInterest.
    %
    /NewInit { % label Nint maps Sint  =>  interest
    	/ShiftInterest exch soften def
	/Maps exch def
	null nulldict nulldict
	/NewInit super send
	ShiftInterest null ne {
	    self /AddKeys ShiftInterest send
	} if
    } def

    %   Override: Tell our Shift we're going away.
    %
    /destroy { % -  =>  -
    	ShiftInterest null ne {
    	    self /RemoveKeys ShiftInterest send
    	    /ShiftInterest null store
    	} if
	/destroy super send
    } def

    %   Update this interest based on our Shift's new state.
    %
    /update { % int => -
    	Maps 2 copy length lt {			% int Maps
    	    exch get /Name exch store
    	} {
    	    % index was out of range; ignore it
    	    pop pop
    	} ifelse
    } def

classend def

% Rather than have the service be an uninstantiated class with an Interest
% as a class var, I'm building this as a class that is instantiated exactly
% once, yielding an interest which IS the service.  Maybe when I get far
% enough along I'll rediscover why this doesn't work.

/ClassKeyService ClassNotifyInterest [/Suites]
classbegin

% Class variables:

    /FocusIntDict dictbegin
	/AcceptFocus  {/trigger /SendInContext 2 index /Interest get send} def
	/RestoreFocus //AcceptFocus def
	/LoseFocus    {/untrigger /SendInContext 2 index /Interest get send} def
    dictend def
    
    % Predefined sets of dependents:
    %
    /BuiltIn dictbegin
	/Default [/StandardKey /NumPadKey] def
    dictend def
    
    % Basic key and shift dictionaries, computed once because they're
    % also used as a starting point when building the meta-key versions.
    %
    /BasicKeyDicts [
	{   ascii000 ascii0S0 ascii00L ascii0S0
	    asciiC00 asciiC00 asciiC00 asciiC00
	} ClassKeyboard send
    ] def

    /BasicShiftsDict growabledict dup {
	/LeftControl keyforsymbol	4
	/RightControl keyforsymbol	4
	/LeftShift keyforsymbol		1
	/RightShift keyforsymbol	1
	/Caps keyforsymbol		2
	% Caps is special; X/NeWS automatically simulates the "locking" aspect
    } /buildkeydict ClassKeyboard send def
    
    % Shift dict including meta keys; not likely to get used often, so we
    % don't worry if a few identical copies get built by separate calls.
    %
    /MetaShiftsDict {
    	dictbegin
	    BasicShiftsDict {def} forall
	dictend dup {
	    /LeftMeta keyforsymbol		8
	    /RightMeta keyforsymbol		8
	} /buildkeydict ClassKeyboard send
    } def
    
    /BetterArrowNames dictbegin
    	/LeftArrowkey /Left def
    	/RightArrowkey /Right def
    	/UpArrowkey /Up def
    	/DownArrowkey /Down def
    	/Homekey /Home def
    dictend def
    
    % This dict maps built-in suite labels to the keymaps and shiftdicts
    % needed for calling /addsuite.  Any given suite is not actually
    % created until the first time a /KeyStart method requests it.  This
    % saves space when some suites are completely unused.  Clients should
    % NOT extend this dictionary; clients add their own suites by
    % calling /addsuite.
    %
    /StandardSuites dictbegin
    	/StandardKey {
    	    BasicKeyDicts BasicShiftsDict
    	} def
    	
    	/MetaKey {
	    [ BasicKeyDicts {pop nulldict} forall
	      BasicKeyDicts aload pop		%  [ nl ... nl a0 aS ... aCSL
	    ]
	    MetaShiftsDict
    	} def
    	
	/NumPadKey {
	    growabledict dup {
		/NumLock keyforsymbol [1 /LockChange] buildinterestsend
	    } /buildkeydict ClassKeyboard send
	    % build [numpad] if no NumLock key, else build [nulldict numpad]
	    [
		1 index length 0 ne {nulldict} if
		/numpadN ClassKeyboard send
	    ]
	    exch
	} def
    	
	/FunctionKey {
	    [/FKeyNames ClassKeyboard send] nulldict
    	} def
    	
	/FunctionString {
	    [/FKeyStrings ClassKeyboard send] nulldict
    	} def
    	
    	/ArrowKey {
    	    /CursKeyNames ClassKeyboard send dup dup {	% dict dict kcode name
    	    	BetterArrowNames exch 2 copy known {get} {exch pop} ifelse
    	    	put dup
    	    } forall pop				% dict
    	    [exch] nulldict
    	} def

	/ArrowString {
	    [/CursKeyStrings ClassKeyboard send] nulldict
    	} def
    	
    dictend def

% Methods:

    % Since this interest is unique, the name/action/canvas are baked in.
    %
    /NewInit { % - => -
    	growabledict SelfAction FocusIntDict /NewInit super send
    	/Suites growabledict def
    } def
    
    % Add a client canvas to the service.  If the client is already the
    % focus, ask it which dependents to activate.  REMIND: It's not clear
    % if this can actually happen given that /addclient is where we register
    % the canvas with the Focus service.
    %
    /addclient { % canvas => -
    	dup /addclient super send
    	dup currentinputfocus eq {
    	    null blockinputqueue
    	    createevent dup /Canvas 3 index put		% cv ev
    	    /trigger self send				% cv
    	} if
	addfocusclient
    } def

    % Remove a canvas as a keyconsumer client.
    %
    /removeclient { % canvas => -
	dup removefocusclient
    	/removeclient super send
    } def

    % Override: Ask the canvas which dependents to activate.
    %
    /ActivateDependents { % event => -
    	dup /KeyStart CurrentClient send {		% ev name|[labels]
    	    dup type /nametype eq {BuiltIn exch get} if	% ev [labels]
    	    growabledict ShiftKeyPriority 3 -1 roll {	% ev dict pri label
    	    	exch minim sub 3 1 roll			% ev pri dict label
    	    	% REMIND: The extra lookup to check if a label is still in
    	    	% StandardSuites happens every time the focus changes.
    	    	% This might not be worth it; we might rather just predefine
    	    	% all the standard suites and accept the space cost.
    	    	StandardSuites 1 index known {
    	    	    StandardSuites 1 index
    	    	    2 copy get exec /addsuite self send
    	    	    1 index undef
    	    	} if
    	    	exch Suites 2 index 2 copy known {	% ev pri lbl dict Su lbl
    	    	    get 2 copy known not {		% ev pri lbl dict Kint
    	    	    	2 copy null put
    	    	    	dup /Action 2 dict put
    	    	    	dup /Priority 5 index put
    	    	    	2 copy /ShiftInterest get null put
    	    	    } if				% ev pri lbl dict Kint
    	    	    dup 3 index /FindDependent self send not {null} if
    	    	    eq /DownTransition /UpTransition ifelse
    	    	    exch /Action get exch		% .. lbl dict adict /xx
    	    	    % REMIND: Does this need to be precomputed to gain speed?
    	    	    [ 5 -1 roll {
    	    	    	1 index /Interest get
    	    	    	/NotifyInterest get /CurrentClient get
    	    	    	send
    	    	    } aload pop ] cvx			% .. dict adict /xx proc
    	    	    put					% ev pri dict
    	    	} {
    	    	    % ignore unrecognised label
    	    	    pop pop exch pop
    	    	} ifelse				% ev pri dict
    	    	exch					% ev dict pri
    	    } forall pop				% ev dict
    	    1 index exch {				% ev ev Dint null
    	    	pop /activate exch send dup		% ev ev
    	    } forall pop pop
    	} {
    	    /CancelNotify self send
	    dup /Canvas null put
	    % Let event continue up the canvas tree; the Canvas field got
	    % set to this particular canvas when it was distributed to it.
	    % REMIND: Do we need to be hairy like the ReceptionService and
	    % avoid having modified the Canvas field in the first place (to
	    % avoid marking the event as /Synthetic)?
    	    redistributeevent
    	} ifelse
    } def
    
    /untrigger { % event => -
    	CurrentClient null ne {
    	    dup /Canvas get dup null eq exch CurrentClient eq or {
    	    	dup /KeyStop CurrentClient send
    	    	/untrigger super send
    	    }{
    	    	dup /Canvas get /KeyStop exch send
    	    	unblockinputqueue
    	    } ifelse
    	}{
    	    /untrigger super send
    	} ifelse
    } def
    
    % Override: If a KeysInterest gets removed, remove the entries from
    % the Suites dict also.
    %
    /RemoveDependent { % Dint => -
    	dup /RemoveDependent super send
    	[ exch Suites {				% [ ... Dint label Kint
    	    2 index eq {exch} {pop} ifelse	% [ ... Dint
    	} forall pop ] {
    	    Suites exch undef
    	} forall
    } def

    % Add a set of keymaps and associated shiftdict to the set of
    % dependents available to clients of the service.  Also update
    % the inverse mapping (/Suites) so we can quickly find the KeyInt
    % given either /Label or /LabelUp.
    %
    /addsuite { % label [maps] shiftdict => -
    	% See if we already have a suite with the same shiftdict
    	dup /FindDependent self send {		% label [maps] sdict Sint
    	    exch pop
    	} {					% label [maps] sdict
    	    self /new ClassShiftInterest send
    	} ifelse				% label [maps] Sint
    	Suites 3 index 5 2 roll self 3 1 roll	% Suites lb lb Nint [maps] Sint
    	/new ClassKeysInterest send 		% Suites label Kint
	3 copy exch dup length string cvs (Up) append cvn exch
	put put
    } def

classend def

/KeyService /new ClassKeyService send def
KeyService /addclient GlobalEventMgr send
