% Initialization:
%	try to load a precomputed set of maps
%

/KeyboardType /kbdtype self send def

KeyboardNames KeyboardType 2 copy known
UserProfile /PrivateKeyTable known not and {
    get LoadFile
} {
    pop pop false
} ifelse

{
   true					%  propagate success
} {
    (NeWS/keybdinit.ps) LoadFile 	%  else try again
    currentdict /ascii000 known and 	%  and propagate this result
} ifelse
					%  bool: is KeyTable initialized?
not {
    console (ClassKeyboard couldn't initialize the keyboard.\n) [] fprintf
} if

classend def %	ClassKeyboard

/classinit ClassKeyboard send
