%	Xaccess.ps: set host access control

Xcompat_private begin

%	XAddHost
%		Xfamily hostname => --
/XAddHost {
    exch pop /addhost ClassAuthorization send
} def

%	XRemoveHost
%		Xfamily hostname => --
/XRemoveHost {
    exch pop /removehost ClassAuthorization send
} def


%	XSetAccessControl
%		mode => -- 
/XSetAccessControl {
    /sethostaccesscontrol ClassAuthorization send
} def


/XListHosts { % - => security-enabled [ hosts ... ]
    /xlisthosts ClassAuthorization send
} def

%	XClientAuthorized
%		authorization_name authorization_data => boolean
%
/XClientAuthorized {
    /clientauthorized? ClassAuthorization send
} def

end    % Xcompat_private




