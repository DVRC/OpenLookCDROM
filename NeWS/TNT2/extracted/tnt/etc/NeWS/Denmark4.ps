    /Pause		 [  21 keyStation /non_character ]	def
    /FunctionR2          [  22 keyStation /function ]	def
    /PrintScreen	 [  22 keyStation /text_func ]	def

    %
    % ScrollLock is a shifted break, but there is
    % no way to do that...
    %
    /FunctionR3          [  23 keyStation /function ]	def
    /ScrollLock		 [  23 keyStation /text_func ]	def
    /Break		 [  23 keyStation /non_character ]	def

