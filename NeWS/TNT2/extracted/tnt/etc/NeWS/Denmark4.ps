%  code classes:
%	shift_key	key changes keyboard state on up & down
%	non_character	key that has no character representation
%	letter		lc for no shifts, UC for Caps or Shift; or Controlled
%	controlled	non-letter for which a Control-shift is meaningful
%	shifted		non-letter which is emitted only when Shift is down
%	unshifted	non-letter which is emitted only when Shift is up
%	anydown		constant char is emitted regardless of shifts
%	cursor		cursor-key; emits escape-string
%	function	not an ASCII char; up and down may be significant
%	text_func	like function; alternate name on right pad
%	number		constant char emitted from number-pad when it's so used

    /FunctionL1          [   1 keyStation /function ]	def
%   /FunctionL11         [   2 keyStation /function ]	def
    /FunctionL2          [   3 keyStation /function ]	def

    /FunctionF1          [   5 keyStation /function ]	def
    /FunctionF2          [   6 keyStation /function ]	def
    /FunctionF10         [   7 keyStation /function ]	def
    /FunctionF3          [   8 keyStation /function ]	def
    /FunctionF11         [   9 keyStation /function ]	def
    /FunctionF4          [  10 keyStation /function ]	def
    /FunctionF12         [  11 keyStation /function ]	def
    /FunctionF5          [  12 keyStation /function ]	def
    /Compose 		 [  13 keyStation /non_character ]	def
    /FunctionF6          [  14 keyStation /function ]	def
%   new key on Danish keyboard
    (~) toChar		 [  15 keyStation /unshifted ]  def
    (^) toChar		 [  15 keyStation /shifted ]    def
    (^) toControlChar    [  15 keyStation /controlled ]	def
    /FunctionF7          [  16 keyStation /function ]	def
    /FunctionF8          [  17 keyStation /function ]	def
    /FunctionF9          [  18 keyStation /function ]	def
    /Alternate		 [  19 keyStation /shift_key ]	def
    /FunctionAlt         [  19 keyStation /function ]	def

