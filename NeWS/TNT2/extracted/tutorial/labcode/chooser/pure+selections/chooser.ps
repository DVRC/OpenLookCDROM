%
%       Creation of canvas1
%
%  Object Description (From Guide File)
%
%  Type                 Canvas-pane
%  Name                 canvas1
%  Help                 Not Defined
%  X			361
%  Y			0
%  Width		131
%  Height		163
%  Foreground Color	()
%  Background Color 	()
%  Menu 		null
%  Horizontal Scrollbar FALSE
%  Scrollable Width	131
%  Vertical Scrollbar    FALSE
%  Scrollable Height	163
%  Repaint Procedure	null
%  Event Handler	null
%  Events		[]
%  Drawing Model	xview
%

/canvas1
    framebuffer /new ChooserCanvas send
def

    /gaps window1 send
pop pop pop % Just want North Gap
 5 5 5 /setgaps window1 send

/Center canvas1 /addclient window1 send

canvas1 /settarget FontMenu send
/DoFontChoice { % item-index menu
    % Get the string of the item
    /item exch send aload pop		% string
    cvn					% name
    findfont 100 scalefont		% font
    /settextfont self send
    /Paint self send
} /installmethod canvas1 send

/DoFontChoice /setnotifier FontMenu send

FontMenu /setmenu canvas1 send

/preferredsize {131 163} /promote canvas1 send

%% When the sliders are updated, we want them to notify their associated
%% textfields; hence the calls to /ExecuteNotifier in /updatesliders
/updatesliders {
    pop
    Hue /setvalue Hue_slider send
    Hue /notifier Hue_slider send /ExecuteNotifier Hue_slider send
    Saturation /setvalue Saturation_slider send
    Saturation /notifier Saturation_slider send /ExecuteNotifier 
    Saturation_slider send
    Brightness /setvalue Brightness_slider send
    Brightness /notifier Brightness_slider send /ExecuteNotifier 
    Brightness_slider send
} /installmethod canvas1 send

    ColorDict  /Black get
    ColorDict /White get
/setcolors canvas1 send

/new ClassEventMgr send /activate window1 send
/map window1 send

