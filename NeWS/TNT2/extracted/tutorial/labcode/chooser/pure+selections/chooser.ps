%
%       Creation of Hue_slider
%
%   Object Description (From Guide File)
%
%   Type		Slider
%   Name		Hue_slider
%   Owner		controls1
%   Help		Not Defined
%   X			72
%   Y			128
%   Width		237
%   Height		15
%   Value x		111
%   Value y		128
%   Slider Width	100
%   Foreground-color    ()
%   Label		(Hue:)
%   Label-type		String
%   Layout type (Label Placed)	Horizontal
%   Orientation		Horizontal
%   Show endboxes	False 
%   Show range		True 
%   Show value		True 
%   Min Value		0
%   Max Value		1
%   Ticks		0
%   Notify Handler	null
%   Event-handler	null
%   Events		[]
%

	%
	%   Creating label 
	%

/Hue_slider-label
    (Hue:)  framebuffer /new ClassLabel send
def

/Hue_slider-label Hue_slider-label [72 128] /addclient controls1 send



	%
	%   Create range labels so that size can be determined
	%    when positioning the actual slider
	%

/Hue_slider_min
    (0) controls1 /new ClassLabel send
def

/Hue_slider_max
    (1) controls1 /new ClassLabel send
def

/Hue_slider_value
    framebuffer /new ClassTextField send
def
	%
	%   Creating slider
	%

/Hue_slider
    framebuffer /new ClassHSlider send
def

0 1 /setrange Hue_slider send

    0 0 120
    /minsize Hue_slider send
    exch pop
 /reshape Hue_slider send 

0 /setvalue Hue_slider send

{100 mul round 100 div} /setnormalizer Hue_slider send
(0) /setvalue Hue_slider_value send

%
%    Connect the slider and its numeric control
%

    %     When the numeric field value changes, update the slider


{ exch { cvr } stopped {
    pop /value /sendtarget 2 index send
    dup dup cvi eq { cvi } if (%) sprintf
    /setvalue 3 -1 roll send
    }{
    {setvalue value dup notifier ExecuteNotifier}
    /sendtarget 3 index send pop pop
    } ifelse
} /setnotifier Hue_slider_value send

    %    When the slider value changes, update the numeric field

{ % value slider => -
    {
	1 index dup dup cvi eq { cvi } if
	(%) sprintf /setvalue Hue_slider_value send
	pop /sethue canvas1 send
    } /sendtarget 2 index send
} /setnotifier Hue_slider send

    %    Set up the dynamic updating of the numeric field
    %    and previewing

{ % value slider => -
    {
	1 index /Normalize Hue_slider send
	dup dup cvi eq { cvi } if
	(%) sprintf /setvalue Hue_slider_value send
	pop /sethue canvas1 send
    } /sendtarget 2 index send
} /setpreviewer Hue_slider send

currentdict /settarget Hue_slider send

	%
	%    Sliders are positioned to the right side of the 
	%    Bounding box with the x value computed by 
	%    subtracting the width of the gauge and the 
	%    maximum range width 
	%
	%    Maximum and minimum values are placed by locating
	%    the appropriate locations from the sizes determined
	%    by querying the labels about their size
	%

/Hue_slider Hue_slider [ 
    304 
    /size Hue_slider_max send pop sub
    /size Hue_slider send pop sub 
    128
] /addclient controls1 send


Hue_slider /settarget Hue_slider_value send
true /setdamageable Hue_slider_value send
0 0 45 16 /reshape Hue_slider_value send
/Hue_slider_value Hue_slider_value [ 111 128 ] /addclient controls1 send
/Hue_slider_min Hue_slider_min [
    294
    /size Hue_slider_max send pop sub
    /size Hue_slider_min send pop sub
    /size Hue_slider send pop sub
 128] /addclient controls1 send

/Hue_slider_max Hue_slider_max [
    309
    /size Hue_slider_max send pop sub
    128
] /addclient controls1 send


