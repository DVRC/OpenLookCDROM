/getdisplaystring { % displayitem => string or () if none
    dup type /arraytype eq {0 get } if
    dup type /arraytype eq {0 get } if
    dup type /stringtype ne { pop ()} if
} /installmethod ClassDrawable send

%
%       Creation of window1
%
%   Object Description (From Devguide File)
%
%   Type		Base-window
%   Name		window1
%   Owner		null
%   Width		654
%   Height		295
%   Background-color    ()
%   Foreground-color    ()
%   Label		(To Do)
%   Label-type		String
%   Mapped		True
%   Show-footer		True
%   Resizable		True
%   Icon-file		()
%   Icon-mask-file	()
%   Event-handler	null
%   Events		[]
%   User-data		null
%

/window1
    null framebuffer /new ClassBaseWindow send
def

0 0 664 355 /reshape window1 send
/place window1 send
(To Do) /setlabel window1 send
/Footer? true /setattribute window1 send

%
%    Code to create TNT Devguide Special Icon
%

{   /size eq {64 64}
    {
        .42 .34 1 hsbcolor setcolor 0 0 64 64 rectpath fill
        /Bookman-DemiItalic findfont 25 scalefont setfont
        0 2 10
        {
            0 1 index add 50 2 index sub moveto
            .59 exch .1 mul 1 sethsbcolor
            (TNT) show
        } for
        /Times-BoldItalic findfont 25 scalefont setfont
        32 20 moveto .91 .49 .74 sethsbcolor
        (guide) cshow
        (todo_min) dup stringwidth pop
	    dup 100 gt {
            100 div 15 exch div
            /Times-Bold findfont exch scalefont setfont
        }{
            pop
	        /Times-Bold findfont 15 scalefont setfont
        } ifelse
        32 6 moveto 0 0 0 setrgbcolor cshow
    } ifelse
} /seticonimage window1 send

/QuitFromUser { % CallingControl => -
    /tagnum -1 /?property self send -1 ne
    {
	/tagnum /property self send tagprint
    }
    {
	console (% quit\n) [/name self send] fprintf
	/QuitFromUser super send
    } ifelse
} /installmethod window1 send



