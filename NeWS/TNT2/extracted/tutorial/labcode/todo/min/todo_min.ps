%
%       Creation of ToDoList
%
%   Object Description (From Devguide File)
%
%   Type		Scrolling-list
%   Name		ToDoList
%   Owner		controls1
%   Help		Not Defined
%   X		    	12
%   Y		   	37
%   Width		200
%   Height		74
%   Foreground-color    ()
%   Label		()
%   Label-type		String
%   Layout type		Horizontal
%   Rows		3 (Function of Height)
%   Read Only		false
%   Multiple Selections	false
%   Selection Required	false
%   Menu		null (Not Implemented)
%   Notify Handler	ChooseItemHandler
%   Event-handler	null
%   Events		[]
%

/ToDoList
    framebuffer /new ClassScrollList send
def

/ToDoList_vbar
    framebuffer /new ClassVScrollbar send
def

%
%    Make scrollbar notify scrolling list
%

ToDoList /settarget ToDoList_vbar send
/scroll /setnotifier ToDoList_vbar send

%
%    Let scrolling list move scrollbar
%

ToDoList_vbar /setscrollbar ToDoList send

%
%    Instantiate border bag for list and scrollbar
%

/ToDoList_bbag
    framebuffer /new ClassBorderBag send
def

/Center ToDoList /addclient ToDoList_bbag send
/East ToDoList_vbar /addclient ToDoList_bbag send
5 5 5 5 /setgaps ToDoList_bbag send

0 0 230 74 /reshape ToDoList_bbag send

%
%    Add to control area
%

/ToDoList_bbag ToDoList_bbag [12 37]  /addclient controls1 send

/GuideSettingCallback /setnotifier ToDoList send
currentdict /settarget ToDoList send
3 /setrowgap ToDoList send

%
%	Set up options
%


%	A Read Only Option is included in XVIEW
%  This list is not readonly

/Exclusive /setchoicemode ToDoList send

%    Devguide allows the forcing of a selection




%
%
%	Notifier GuideButtonCallback
%
%	Used by:
%
%	Object               Type
%	------------------------------------------------------
%	InsertButton         Button Notifier
%	DeleteButton         Button Notifier
%

/GuideButtonCallback { % Index Instance => -
    /tagnum -1 /?property 3 index send -1 ne
    {
	/tagnum /property 3 -1 roll send tagprint
    }{
	pop
    } ifelse
    pop
} ?def

%
%
%	Notifier GuideSettingCallback
%
%	Used by:
%
%	Object               Type
%	------------------------------------------------------
%	ToDoList             Scrolling-list Notifier
%

/GuideSettingCallback { % Array Instance => -
    /tagnum -1 /?property 3 index send -1 ne
    {
	/tagnum /property 2 index send tagprint
	exch
	dup 0 get dup typedprint		% index on wire
	exch 1 get 
	{
	    1 typedprint			% true on wire
	}{
	    0 typedprint			% false on wire
	} ifelse
	/item 3 -1 roll send
	/getdisplaystring ClassDrawable send typedprint
    }{
	pop pop
    } ifelse
} ?def

%
%   This routine is called from the client to
%   make the jot canvas and scrollbar the /Center and /East
%   clients of the given BorderBag
%

/ADDJ { % width height canvas win => -
    3 dict begin
	/win exch def
	/cv exch def

	/sbar	framebuffer /new ClassVScrollbar send	def
	sbar /ScrollbarInitialize cv send
	/Scroll /setnotifier sbar send

	true /setmenuable cv send
	cv /settarget sbar send

	/Center cv   /addclient win send
	/East   sbar /addclient win send
	2 array astore cvx /preferredsize exch /promote cv send
	{ 0 0 preferredsize reshape } win send
    end
} def


