(% De\336ne a routine and a menu.) 54 642 T
(%) 54 626 T
(% init_canvas accepts a JOT canvas parameter. It creates a base window) 54 610 T
(% and a scrollbar, and inserts the scrollbar and the JOT canvas) 54 594 T
(% into the base window. Then it attaches the scrollbar to the JOT) 54 578 T
(% canvas. When it\325s done it creates an event manager and activates) 54 562 T
(% the base window, which activates the JOT canvas and scrollbar.) 54 546 T
(%) 54 530 T
(% The menu is simply a list of well-known font families. When a) 54 514 T
(% client selects an item from the menu, the selected family name) 54 498 T
(% is sent up the wire to the client-side menu callback.) 54 482 T
(%) 54 466 T
(cdef ps_joe_initialize\050menu_tag\051) 54 434 T
(    /init_canvas { % JotCanvas => -) 54 418 T
(5 dict begin) 81 402 T
(    /cv exch def) 81 386 T
(    /win cv framebuffer /new ClassBaseWindow send def) 81 370 T
(    /sbar framebuffer /new ClassVScrollbar send def) 81 354 T
(    /preferredsize { 500 600 } /installmethod cv send) 81 322 T
(    cv /settarget sbar send) 81 306 T
(    sbar /ScrollbarInitialize cv send) 81 290 T
(    /Scroll /setnoti\336er sbar send) 81 274 T
(    /Scroll /setpreviewer sbar send) 81 258 T
(    /East sbar /addclient win send) 81 226 T
(    0 2 0 2 /setgaps win send) 81 194 T
(    0 0 /preferredsize win send /reshape win send) 81 162 T
